# PostgreSQL connection string. Neon pooled connection strings are recommended on Vercel.
DATABASE_URL=postgresql://qport:qport@127.0.0.1:5432/qport

# Required on the first Vercel deployment. The admin password is hashed before storage.
QPORT_ADMIN_PASSWORD=change-me-before-deploy

# Vercel Cron sends Authorization: Bearer <CRON_SECRET> when this variable exists.
CRON_SECRET=replace-with-a-long-random-secret

# Local HTTP development should not force Secure cookies.
QPORT_COOKIE_SECURE=0

# Optional. Keep API docs disabled in production by default.
QPORT_API_DOCS=0
